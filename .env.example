# X Monitor Environment

# SQLite location
SQLITE_PATH=./data/x-monitor.db

# Redis
REDIS_URL=redis://localhost:6379

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X cookies
COOKIES_FINTAX_OFFICIAL=/Users/nightyoung/twitter_cookies_fintax_en.json

# AI behavior
CLAUDE_BIN=claude
RUN_LIVE_CLAUDE=0

# Dify KB (optional; if unset, falls back to in-memory kb-fixture)
DIFY_API_KEY=
DIFY_DATASET_ID=
DIFY_BASE_URL=https://api.dify.ai/v1

# Dev / dry-run
POSTER_DRY_RUN=1

# 3rd-party scanner provider (none|apify|tweetscout)
THIRDPARTY_PROVIDER=none
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apidojo~tweet-scraper
TWEETSCOUT_API_KEY=
SCANNER_3RDPARTY_INTERVAL_MS=1800000
THIRDPARTY_TRIGGER_AGE_MS=1800000

# fresh-kb-indexer cadence
KB_INDEXER_INTERVAL_MS=3600000

# watchdog
WATCHDOG_TICK_MS=120000
WATCHDOG_MAX_STALE_S=300
