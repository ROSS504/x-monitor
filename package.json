{
  "name": "x-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' build",
    "test": "pnpm -r --filter='./packages/*' --filter='./apps/*' test",
    "lint": "pnpm -r lint",
    "dev": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop ecosystem.config.cjs",
    "seed": "tsx scripts/seed.ts",
    "inspect": "tsx scripts/inspect.ts",
    "ai-routine": "tsx scripts/ai-routine.ts"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "tsx": "^4.21.0",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@x-monitor/app-ai-worker": "workspace:^",
    "@x-monitor/db": "workspace:^",
    "@x-monitor/observability": "workspace:^",
    "@x-monitor/queue": "workspace:^"
  }
}
